# Teamwork
TEAMWORK_API_KEY=
# Your Teamwork site, e.g. https://forwardfinancialintelligenceinc.teamwork.com
TEAMWORK_BASE_URL=https://yoursite.teamwork.com

# BigQuery
GCP_PROJECT_ID=radiant-rig-284611
BQ_DATASET=teamwork_data
BQ_LOCATION=US
# Path to a GCP service account JSON key with BigQuery Data Editor + BigQuery Job User
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Timezone used to compute "current calendar month" for the timelogs replace
# window (e.g. America/New_York, America/Chicago, UTC). Pick whatever
# timezone your team's Teamwork "day" is anchored to.
SYNC_TIMEZONE=UTC
